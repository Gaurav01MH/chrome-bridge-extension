{
  "manifest_version": 3,
  "name": "ChromeBridge",
  "version": "0.1.0",
  "description": "Connects your existing Chrome profile to the local ChromeBridge terminal.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "debugger"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChromeBridge"
  }
}

